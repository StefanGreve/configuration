[column]
    ui = auto
[user]
    email = stefan.ohlsen.greve@gmail.com
    name = StefanGreve
    signingkey = 3D37004E3A1EE085
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[core]
    editor = nvim
    autocrlf = false
    pager = "delta --syntax-theme='Solarized (dark)' --dark"
    excludesfile = ~/.gitignore
    fsmonitor = true
    untrackedCache = true
    precomposeUnicode = true
[interactive]
    diffFilter = delta --color-only --features=interactive
[delta]
    navigate = true
    light = false
    hyperlinks = true
    features = decorations
[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
    autoupdate = true
[init]
    defaultBranch = master
[commit]
    verbose = true
    gpgsign = true
[gpg]
    program = /opt/homebrew/bin/gpg
[push]
    autoSetupRemote = true
    followTags = true
[pull]
    rebase = true
[alias]
    init-empty = !"f() { git init && git commit --allow-empty --allow-empty-message --no-edit; }; f"
    unstage = reset HEAD --
    uncommit = reset --soft HEAD^1
    last = log -1 HEAD --show-signature
    graph = log --date-order --graph --all --date=short --pretty=format:\"%x09%C(auto)%h  %C(cyan)%ad  %C(green)%aN  %x09%C(reset)%s\"
    purge = "!f(){ git restore . && git clean -f .; };f"
    push-notes = push origin refs/notes/*
    pull-notes = fetch origin refs/notes/*:refs/notes/*
    orphans = fsck --full
    ls-authors = shortlog --summary --numbered --all --no-merges
    ls-ignored = ls-files --ignored --exclude-standard --others
    ls-untracked = ls-files --exclude-standard --others
[http]
    sslverify = true
[url "ssh://git@github.com/"]
    insteadOf = https://github.com/
[safe]
    directory = *
[help]
    autocorrect = prompt
    format = html
