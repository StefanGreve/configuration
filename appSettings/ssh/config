# Raspberry Pi 3B
Host rpi3 rpi3.local
    HostName 192.168.2.111
    User stefan
    Port 1995
    IdentityFile ~/.ssh/rpi3
    IdentitiesOnly yes
    AddKeysToAgent yes

# personal account
Host github.com
    User git
    HostName github.com
    IdentityFile ~/.ssh/id_rsa
    IdentitiesOnly yes
    AddKeysToAgent yes

# work account
Host git.swisslab.de
    User git
    HostName git.swisslab.de
    IdentityFile ~/.ssh/work
    IdentitiesOnly yes
    AddKeysToAgent yes
    HostKeyAlgorithms +ssh-rsa
    PubKeyAcceptedAlgorithms +ssh-rsa
