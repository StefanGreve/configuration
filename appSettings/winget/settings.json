{
    "$schema": "https://aka.ms/winget-settings.schema.json",
    "visual": {
        "enableSixels": true,
        "progressBar": "retro",
        "anonymizeDisplayedPaths": true
    },
    "installBehavior": {
        "disableInstallNotes": true,
        "preferences": {
            "scope": "user",
            "locale": [
                "en-US",
                "ja-JP"
            ],
            "architectures": [
                "x64"
            ],
            "installerTypes": [
                "msi",
                "msix",
                "exe"
            ]
        }
    },
    "uninstallBehavior": {
        "purgePortablePackage": true
    },
    "network": {
        "downloader": "wininet"
    },
    "telemetry": {
        "disable": true
    },
    "experimentalFeatures": {
        "directMSI": true,
        "fonts": true,
        "sourcePriority": true
    }
}
