Windows Registry Editor Version 5.00

; ==============================================================================
; WINDOWS 11 SYSTEM REGISTRIES
; ==============================================================================

; --- windows search -----------------------------------------------------------
; disable dynamic search box in windows search
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsDynamicSearchBoxEnabled"=dword:00000000

; removes bing search results from windows search results
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\Explorer]
"DisableSearchBoxSuggestions"=dword:00000001

; --- shell / explorer ---------------------------------------------------------
; restore classic windows 10 context menu
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}]
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""

; --- windows 11 AI ------------------------------------------------------------
; disable Windows Recall (periodic AI screen snapshots); relevant on Copilot+ PCs
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"DisableAIDataAnalysis"=dword:00000001

; turn off Windows Copilot (partly deprecated since Copilot became a Store app)
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\WindowsCopilot]
"TurnOffWindowsCopilot"=dword:00000001

; --- telemetry / cloud sync ---------------------------------------------------
; do not sync the clipboard across devices via the cloud
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System]
"AllowCrossDeviceClipboard"=dword:00000000

; do not accept online (cloud) speech recognition
[HKEY_CURRENT_USER\Software\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy]
"HasAccepted"=dword:00000000

; never ask for feedback (Feedback frequency = Never)
[HKEY_CURRENT_USER\Software\Microsoft\Siuf\Rules]
"NumberOfSIUFInPeriod"=dword:00000000

; opt out of letting websites read the OS language list
[HKEY_CURRENT_USER\Control Panel\International\User Profile]
"HttpAcceptLanguageOptOut"=dword:00000001

; --- suggestion / ad surfaces -------------------------------------------------
; stop tracking opened apps/docs (Start and jump-list suggestions),
; disable Start recommendations/tips, and Explorer sync-provider ad notifications
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Start_TrackProgs"=dword:00000000
"Start_TrackDocs"=dword:00000000
"Start_IrisRecommendations"=dword:00000000
"ShowSyncProviderNotifications"=dword:00000000

; disable the 'finish setting up your device' nag (SCOOBE)
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\UserProfileEngagement]
"ScoobeSystemSettingEnabled"=dword:00000000

; --- widgets / news feed ------------------------------------------------------
; hide the Widgets button on the taskbar (per-user); the HKLM Dsh policy for
; News and Interests is ACL-locked by MDM on managed machines and cannot be set
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"TaskbarDa"=dword:00000000
