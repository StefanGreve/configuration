Windows Registry Editor Version 5.00

; ==============================================================================
; WINDOWS 11 SYSTEM REGISTRIES
; ==============================================================================

; --- windows search -----------------------------------------------------------
; disable dynamic search box in windows search
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\SearchSettings]
"IsDynamicSearchBoxEnabled"=dword:00000000

; removes bing search results from windows search results
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\Explorer]
"DisableSearchBoxSuggestions"=dword:00000001

; --- shell / explorer ---------------------------------------------------------
; restore classic windows 10 context menu
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}]
[HKEY_CURRENT_USER\Software\Classes\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32]
@=""

; --- windows 11 AI ------------------------------------------------------------
; disable Windows Recall (periodic AI screen snapshots); relevant on Copilot+ PCs
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\WindowsAI]
"DisableAIDataAnalysis"=dword:00000001

; turn off Windows Copilot (partly deprecated since Copilot became a Store app)
[HKEY_CURRENT_USER\Software\Policies\Microsoft\Windows\WindowsCopilot]
"TurnOffWindowsCopilot"=dword:00000001

; --- telemetry / cloud sync ---------------------------------------------------
; do not sync the clipboard across devices via the cloud
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\System]
"AllowCrossDeviceClipboard"=dword:00000000

; do not accept online (cloud) speech recognition
[HKEY_CURRENT_USER\Software\Microsoft\Speech_OneCore\Settings\OnlineSpeechPrivacy]
"HasAccepted"=dword:00000000

; never ask for feedback (Feedback frequency = Never)
[HKEY_CURRENT_USER\Software\Microsoft\Siuf\Rules]
"NumberOfSIUFInPeriod"=dword:00000000

; opt out of letting websites read the OS language list
[HKEY_CURRENT_USER\Control Panel\International\User Profile]
"HttpAcceptLanguageOptOut"=dword:00000001

; --- suggestion / ad surfaces -------------------------------------------------
; stop tracking opened apps/docs (Start and jump-list suggestions),
; disable Start recommendations/tips, and Explorer sync-provider ad notifications
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"Start_TrackProgs"=dword:00000000
"Start_TrackDocs"=dword:00000000
"Start_IrisRecommendations"=dword:00000000
"ShowSyncProviderNotifications"=dword:00000000

; disable the 'finish setting up your device' nag (SCOOBE)
[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\UserProfileEngagement]
"ScoobeSystemSettingEnabled"=dword:00000000

; --- security hardening -------------------------------------------------------
; the entries below come from claude-hardening.md. items that cannot be expressed as
; static registry data (per-interface NetbiosOptions, firewall profile scoping, auditpol,
; Set-ProcessMitigation, certificate removal, wlan profiles) are documented there instead.

; restore mark-of-the-web on downloaded files. SaveZoneInformation=2 stops Windows from
; writing the Zone.Identifier stream, which silently disables SmartScreen, Office Protected
; View and the corporate BlockContentExecutionFromInternet policy. deleting the value
; restores the default (write MOTW).
[HKEY_CURRENT_USER\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Attachments]
"SaveZoneInformation"=-

; --- name resolution ----------------------------------------------------------
; disable mDNS. LLMNR is already off by GPO; NetBIOS over TCP/IP must be disabled per
; interface (NetbiosOptions=2) and the subkeys are machine-specific GUIDs, so not here.
; note: breaks .local discovery (AirPrint, some IoT/embedded workflows).
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Dnscache\Parameters]
"EnableMDNS"=dword:00000000

; --- windows script host ------------------------------------------------------
; allow only signed WSH scripts (BSI 5.5.2.1). for the stricter HD variant set
; "Enabled"=dword:00000000 and "Remote"=dword:00000000 instead.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Script Host\Settings]
"TrustPolicy"=dword:00000002

; --- powershell logging -------------------------------------------------------
; record compiled script blocks in Microsoft-Windows-PowerShell/Operational. no GPO
; governs this key. invocation logging is deliberately left off: far too noisy.
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging]
"EnableScriptBlockLogging"=dword:00000001

; --- print spooler ------------------------------------------------------------
; stop the spooler accepting inbound remote RPC; local and outbound printing are unaffected
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\Printers]
"RegisterSpoolerRemoteRpcEndPoint"=dword:00000000

; pin the PrintNightmare point-and-print mitigation rather than relying on the default
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Windows NT\Printers\PointAndPrint]
"RestrictDriverInstallationToAdministrators"=dword:00000001

; --- location -----------------------------------------------------------------
; deny machine-wide location access
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location]
"Value"="Deny"

; --- office macros ------------------------------------------------------------
; disable all VBA macros without notification (4). use 3 to still allow signed macros.
[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Office\16.0\Word\Security]
"VBAWarnings"=dword:00000004

[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Office\16.0\Excel\Security]
"VBAWarnings"=dword:00000004

[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Office\16.0\PowerPoint\Security]
"VBAWarnings"=dword:00000004

[HKEY_CURRENT_USER\SOFTWARE\Policies\Microsoft\Office\16.0\Access\Security]
"VBAWarnings"=dword:00000004
