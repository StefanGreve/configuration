{
    "Windows": {
        "claude": [
            {
                "path": ".\\appSettings\\claude\\CLAUDE.md",
                "target": "$HOME\\.claude\\CLAUDE.md"
            },
            {
                "path": ".\\appSettings\\claude\\statusline.ps1",
                "target": "$HOME\\.claude\\statusline.ps1"
            }
        ],
        "code": [
            {
                "path": ".\\appSettings\\code\\settings.json",
                "target": "$env:APPDATA\\Code\\User\\settings.json"
            },
            {
                "path": ".\\appSettings\\code\\keybindings.json",
                "target": "$env:APPDATA\\Code\\User\\keybindings.json"
            }
        ],
        "git": [
            {
                "path": ".\\appSettings\\git\\.gitconfig",
                "target": "$HOME\\.gitconfig"
            }
        ],
        "gnupg": [
            {
                "path": ".\\appSettings\\gnupg\\gpg-agent.conf",
                "target": "$env:APPDATA\\gnupg\\gpg-agent.conf"
            },
            {
                "path": ".\\appSettings\\gnupg\\gpg.conf",
                "target": "$env:APPDATA\\gnupg\\gpg.conf"
            }
        ],
        "nvim": [
            {
                "path": ".\\appSettings\\nvim\\init.vim",
                "target": "$env:LOCALAPPDATA\\nvim\\init.vim"
            }
        ],
        "pip": [
            {
                "path": ".\\appSettings\\pip\\pip.ini",
                "target": "$env:APPDATA\\pip\\pip.ini"
            }
        ],
        "ssh": [
            {
                "path": ".\\appSettings\\ssh\\config",
                "target": "$HOME\\.ssh\\config"
            }
        ],
        "winget": [
            {
                "path": ".\\appSettings\\winget\\settings.json",
                "target": "$env:LOCALAPPDATA\\Packages\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\LocalState\\settings.json"
            }
        ],
        "wt": [
            {
                "path": ".\\appSettings\\wt\\settings.json",
                "target": "$env:LOCALAPPDATA\\Packages\\Microsoft.WindowsTerminal_8wekyb3d8bbwe\\LocalState\\settings.json"
            }
        ]
    },
    "MacOS": {
        "claude": [
            {
                "path": "./appSettings/claude/CLAUDE.md",
                "target": "~/.claude/CLAUDE.md"
            },
            {
                "path": "./appSettings/claude/statusline.ps1",
                "target": "$HOME/.claude/statusline.ps1"
            }
        ],
        "git": [
            {
                "path": "./appSettings/git/macos/.gitconfig",
                "target": "~/.gitconfig"
            }
        ],
        "gnupg": [
            {
                "path": "./appSettings/gnupg/macos/gpg-agent.conf",
                "target": "~/.gnupg/macos/gpg-agent.conf"
            },
            {
                "path": "./appSettings/gnupg/gpg.conf",
                "target": "~/.gnupg/gpg.conf"
            }
        ],
        "nvim": [
            {
                "path": "./appSettings/nvim/macos/init.vim",
                "target": "~/.config/nvim/init.vim"
            }
        ],
        "profile": [
            {
                "path": "./macos/usr/.profile",
                "target": "~/.profile"
            }
        ],
        "ssh": [
            {
                "path": "./appSettings/ssh/macos/config",
                "target": "~/.ssh/config"
            }
        ]
    }
}
